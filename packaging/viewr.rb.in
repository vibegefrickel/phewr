# Homebrew formula, generated by `just tap` from packaging/viewr.rb.in into the tap repo
# (https://codeberg.org/webgefrickel/homebrew-tap); @VERSION@ and @SHA256@ are filled in.
class Viewr < Formula
  desc "Terminal image and video gallery for the Kitty graphics protocol"
  homepage "https://codeberg.org/webgefrickel/viewr"
  url "https://codeberg.org/webgefrickel/viewr/releases/download/v@VERSION@/viewr-macos-arm64.tar.gz"
  version "@VERSION@"
  sha256 "@SHA256@"
  license "MIT"

  depends_on arch: :arm64
  depends_on "ffmpeg"
  depends_on "libheif"
  depends_on :macos
  depends_on "mpv"

  def install
    bin.install "bin/viewr"
  end

  def caveats
    <<~EOS
      viewr draws through the Kitty graphics protocol. Run it in Ghostty or another terminal with this protocol.
    EOS
  end

  test do
    assert_match "viewr #{version}", shell_output("#{bin}/viewr --version")
  end
end
