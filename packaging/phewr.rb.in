# Homebrew formula, generated by `just tap` from packaging/phewr.rb.in into the tap repo
# (https://codeberg.org/webgefrickel/homebrew-tap); @VERSION@ and @SHA256@ are filled in.
class Phewr < Formula
  desc "Terminal image and video gallery for the Kitty graphics protocol"
  homepage "https://codeberg.org/webgefrickel/phewr"
  url "https://codeberg.org/webgefrickel/phewr/releases/download/v@VERSION@/phewr-macos-arm64.tar.gz"
  version "@VERSION@"
  sha256 "@SHA256@"
  license "MIT"

  depends_on arch: :arm64
  depends_on "libheif"
  depends_on :macos
  # phewr starts these programs from PATH when they exist. Without ffmpeg, videos and animations
  # do not play in the terminal and have no thumbnail. Without mpv, `p` has no window.
  depends_on "ffmpeg" => :recommended
  depends_on "mpv" => :recommended

  def install
    bin.install "bin/phewr"
  end

  def caveats
    <<~EOS
      phewr draws through the Kitty graphics protocol. Run it in Ghostty or another terminal with this protocol.
      Videos and animations need ffmpeg on PATH, and `p` opens them in mpv: brew install ffmpeg mpv
    EOS
  end

  test do
    assert_match "phewr #{version}", shell_output("#{bin}/phewr --version")
  end
end
