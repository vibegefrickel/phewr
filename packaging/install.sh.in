#!/bin/sh
# viewr installer, uploaded as a release asset by `just publish`.
# Generated from packaging/install.sh.in; @VERSION@ and @SHA256@ are filled in.
set -eu

main() {
  [ "$(uname -s)" = "Darwin" ] && [ "$(uname -m)" = "arm64" ] || {
    echo "viewr needs macOS on Apple Silicon"
    exit 1
  }
  # The binary links these Homebrew libraries.
  for lib in libheif/lib/libheif.1.dylib ffmpeg/lib/libavcodec.dylib; do
    [ -e "/opt/homebrew/opt/$lib" ] || {
      echo "viewr: Homebrew libheif and ffmpeg are missing: brew install libheif ffmpeg mpv" >&2
      exit 1
    }
  done
  url="https://codeberg.org/webgefrickel/viewr/releases/download/v@VERSION@/viewr-macos-arm64.tar.gz"
  prefix="${PREFIX:-$HOME/.local}"
  tmp=$(mktemp -d)
  trap 'rm -rf "$tmp"' EXIT
  curl -fsSL -o "$tmp/viewr.tar.gz" "$url" || {
    echo "viewr: download failed: $url" >&2
    exit 1
  }
  echo "@SHA256@  $tmp/viewr.tar.gz" | shasum -a 256 -c - >/dev/null 2>&1 || {
    echo "viewr: checksum mismatch for $url, nothing installed" >&2
    exit 1
  }
  mkdir -p "$prefix"
  tar -xzf "$tmp/viewr.tar.gz" -C "$prefix" bin/viewr
  echo "Installed viewr @VERSION@ to $prefix/bin"
  case ":$PATH:" in
    *":$prefix/bin:"*) ;;
    *) shown=$(printf '%s' "$prefix/bin" | sed "s#^$HOME#\\\$HOME#")
       echo "Note: $prefix/bin is not on your PATH; add this line to ~/.zshrc:"
       echo "  export PATH=\"$shown:\$PATH\"" ;;
  esac
  echo "Next: run 'viewr' in a folder with pictures, in Ghostty, Kitty or WezTerm."
}

main "$@"
